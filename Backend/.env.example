# Server
NODE_ENV=development
# Prefer 5050 locally — macOS often binds 5000 (AirPlay); Chrome blocks 5061 (ERR_UNSAFE_PORT)
PORT=5050

# Required
MONGO_URI=mongodb://127.0.0.1:27017/reporadar
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# LLM (required for analysis + chat)
GROQ_API_KEY=
GROQ_TIMEOUT_MS=30000
# Optional model override
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# GitHub API (optional for public repos; higher rate limits when set)
GITHUB_TOKEN=

# Flask git_analyzer sidecar
FLASK_ANALYZER_URL=http://localhost:5001
FLASK_ANALYZER_TIMEOUT_MS=5000

# Repository analysis engine (optional tuning)
# ANALYSIS_MAX_FILES=40
# ANALYSIS_MAX_FILE_SIZE=120000
# ANALYSIS_MAX_TOTAL_CONTENT=45000
# ANALYSIS_CLONE_TIMEOUT_MS=90000
# ANALYSIS_TIMEOUT_MS=180000
# ANALYSIS_GROQ_TIMEOUT_MS=90000
# ANALYSIS_GROQ_MAX_TOKENS=3500
# ANALYSIS_STALE_MS=210000
# ANALYSIS_TEMP_MAX_AGE_MS=210000
# ANALYSIS_DUPLICATE_WINDOW_MS=900000
# ANALYSIS_RECOVERY_INTERVAL_MS=600000

# Rate limits (per IP)
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=40

# Browser CORS allowlist (comma-separated). Required in production.
# Example local: http://localhost:3000
# Example prod:  https://your-frontend.example.com
CORS_ORIGINS=http://localhost:3000
