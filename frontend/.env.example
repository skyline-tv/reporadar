# Backend API base URL (no trailing slash).
# Local development (macOS often occupies :5000 via AirPlay — use 5061):
NEXT_PUBLIC_API_URL=http://localhost:5061

# Production example:
# NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Do NOT put secrets here. Never set GROQ_API_KEY, JWT_SECRET, or GITHUB_TOKEN
# as NEXT_PUBLIC_* variables — they would be exposed to the browser.
